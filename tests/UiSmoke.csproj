<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\UiSmoke\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\UiSmoke\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="UiSmoke.cs" />
    <Reference Include="UIAutomationClient" HintPath="C:\Program Files\dotnet\packs\Microsoft.WindowsDesktop.App.Ref\10.0.12\ref\net10.0\UIAutomationClient.dll" />
    <Reference Include="UIAutomationTypes" HintPath="C:\Program Files\dotnet\packs\Microsoft.WindowsDesktop.App.Ref\10.0.12\ref\net10.0\UIAutomationTypes.dll" />
  </ItemGroup>
</Project>
