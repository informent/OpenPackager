<Window x:Class="OpenPackager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OpenPackager" Width="1180" Height="760" MinWidth="980" MinHeight="640" Background="{StaticResource Background}" WindowStartupLocation="CenterScreen">
  <Grid Margin="34">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0"><StackPanel><TextBlock Text="OPENPACKAGER" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="Ship software with confidence." FontSize="32" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="A local, transparent release builder for Windows developers." Foreground="{StaticResource Muted}" FontSize="15" Margin="0,5,0,0"/></StackPanel><Border HorizontalAlignment="Right" Background="#182642" CornerRadius="18" Padding="14,8" VerticalAlignment="Top"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource Good}" Margin="0,0,8,0"/><TextBlock Text="LOCAL ONLY" Foreground="{StaticResource Good}" FontWeight="SemiBold" FontSize="11"/></StackPanel></Border></Grid>
    <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Margin="0,28,0,18" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PROJECT FOLDER" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/><TextBox x:Name="ProjectPath" Text="" Background="Transparent" Foreground="{StaticResource Text}" BorderThickness="0" FontSize="15" Padding="0,8,0,0"/><TextBlock x:Name="ProjectHint" Text="Choose a project to begin." Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel><Button Grid.Column="1" Content="Choose folder" Click="ChooseFolder_Click" VerticalAlignment="Center"/></Grid></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,14,0"><TextBlock Text="Release profile" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Configure a reproducible Windows build." Foreground="{StaticResource Muted}" Margin="0,4,0,18"/><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="22"><StackPanel><TextBlock Text="TARGET" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/><ComboBox x:Name="Runtime" SelectedIndex="0" Margin="0,8,0,20" Padding="8"><ComboBoxItem Content="Windows 64-bit · win-x64" Tag="win-x64"/></ComboBox><CheckBox x:Name="SelfContained" IsChecked="True" Content="Self-contained application" Foreground="{StaticResource Text}" Margin="0,0,0,15"/><CheckBox x:Name="SingleFile" IsChecked="True" Content="Bundle into one executable" Foreground="{StaticResource Text}"/><Separator Margin="0,22" Background="{StaticResource Border}"/><StackPanel Orientation="Horizontal"><Button Content="Scan project" Click="Scan_Click"/><Button Content="Build release" Click="Build_Click" Background="{StaticResource Accent}"/></StackPanel></StackPanel></Border></StackPanel>
      <StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="Project health" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Checks before anything is published." Foreground="{StaticResource Muted}" Margin="0,4,0,18"/><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="22" MinHeight="260"><StackPanel><TextBlock x:Name="ProjectType" Text="Not scanned" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="HealthText" Text="Choose a folder, then scan it." Foreground="{StaticResource Muted}" Margin="0,7,0,20" TextWrapping="Wrap"/><TextBlock Text="ACTIVITY" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/><TextBox x:Name="Activity" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="{StaticResource Muted}" BorderThickness="0" Height="100" Margin="0,8,0,0"/></StackPanel></Border></StackPanel>
    </Grid>
    <TextBlock Grid.Row="3" Text="OpenPackager 0.2.0  ·  Builds stay on this machine  ·  MIT licensed" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,22,0,0"/>
  </Grid>
</Window>
